{
  "name": "modu-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute modu --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute modu --remote --file=./schema.sql"
  },
  "dependencies": {
    "better-auth": "^1.4.0",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250726.0",
    "wrangler": "^4.28.0"
  }
}
